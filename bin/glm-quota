#!/bin/bash
# glm-quota — fetch GLM quota usage and emit JSON for the tomaswade.glm-quota
# omarchy bar plugin.
#
# Contract: ALWAYS prints one valid JSON object and exits 0. Network/API/key
# failures fall back to the cached report (marked "stale": true) or to an
# empty report, so the QML caller never has to handle a broken pipe.
#
# Output shape:
#   { "level": "pro", "fetchedAt": <epoch ms>, "stale": false,
#     "error": "",   # "" | "nokey" | "badkey" | "unauthorized" | "network" | "badresp"
#     "fiveHour": { "used", "quota", "remaining", "windowMs", "nextResetMs" },
#     "weekly":   { ... } }
#
# Error codes (machine-readable; the QML side maps them to localized text):
#   nokey         api.key missing or empty
#   badkey        key file failed the security check: must be a regular file
#                 (never followed through a symlink, nor any parent directory
#                 component), owned by the current user, with no group/other
#                 permission bits, holding one bare key of [A-Za-z0-9._-] on
#                 the first line
#   unauthorized  HTTP 401/403 — key invalid or expired
#   network       curl could not reach the API
#   badresp       API answered but the payload had no usable limits, or the
#                 response exceeded the byte ceiling
#
# Security design (review hardening, round 2):
#   * All file access goes through bin/glm-quota-secio.py, which resolves
#     paths component-by-component with O_NOFOLLOW, keeps the verified
#     directory descriptor open, and fstat(2)s every file *after* opening
#     it. Checks and uses are fused on the same descriptor, so swapping a
#     pathname (or a parent component) for a symlink between a check and a
#     use is structurally impossible.
#   * The API key never appears in any process argv or environment: it is
#     read through a secured descriptor and fed to curl through a config
#     stream on a private file descriptor (-K <(...)).
#   * The key's charset is validated before it enters the curl config, so
#     the key file cannot inject curl directives.
#   * The response body is capped on the producer side: it flows through
#     `head -c MAX+1`, and anything over MAX_BYTES is rejected before
#     any parsing happens.
#   * Cache updates are published through an exclusive, unpredictable
#     same-directory temporary (secrets(3)-random name, O_CREAT|O_EXCL|
#     O_NOFOLLOW) created and renamed relative to the pinned directory
#     descriptor; planted symlinks on the cache path are replaced by
#     rename(2), never followed.
#
# Usage: glm-quota [--force] [--key-file <path>]
#   --force      bypass the cache TTL and hit the API
#   --key-file   key file override; default: api.key next to the plugin root

set -u
umask 077

BIN_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SECIO="$BIN_DIR/glm-quota-secio.py"
CACHE_DIR="$HOME/.cache"
CACHE_NAME="glm-quota.json"
TTL=240
MAX_BYTES=65536
API="https://open.bigmodel.cn/api/monitor/usage/quota/limit"
FIVE_HOUR_MS=18000000
WEEK_MS=604800000

FORCE=0
KEY_FILE="${BIN_DIR%/bin}/api.key"
while [ $# -gt 0 ]; do
  case "$1" in
    --force) FORCE=1 ;;
    --key-file) shift; KEY_FILE="${1:-}" ;;
    *) ;;
  esac
  shift
done

now_ms() { date +%s%3N; }

emit_empty() {
  jq -nc --arg err "$1" --argjson now "$(now_ms)" \
    '{level: "", fetchedAt: $now, stale: true, error: $err, fiveHour: null, weekly: null}'
}

# Serve the cached report, flagged stale and stamped with the failure code so
# the UI can explain why the numbers stopped updating. The cache body was
# already read through a verified descriptor; it is only re-framed here.
emit_stale_cache() {
  jq -c --arg err "$1" '.stale = true | .error = $err' <<<"$CACHED_BODY"
}

# Stale cache when we have a usable one, empty report otherwise.
emit_fail() {
  if [ "$CACHED_OK" = 1 ]; then
    emit_stale_cache "$1"
  else
    emit_empty "$1"
  fi
}

# --- Cache read: one fused secure operation -------------------------------
# secio walks ~/.cache with O_NOFOLLOW, pins the verified directory
# descriptor, opens the cache file with O_NOFOLLOW, fstat(2)s and reads it
# through that descriptor, and prints "<mtime_seconds>\n<body>".
CACHED_BODY=""
CACHED_MTIME=0
CACHED_OK=0
CACHE_W=1
sec_out="$(python3 "$SECIO" read-cache "$CACHE_DIR" "$CACHE_NAME" 2>/dev/null)"
case $? in
  0)
    CACHED_MTIME="${sec_out%%$'\n'*}"
    CACHED_BODY="${sec_out#*$'\n'}"
    if [ -n "$CACHED_BODY" ] && [ "$CACHED_MTIME" != "$CACHED_BODY" ] \
      && jq -e '(.fiveHour != null) and (.weekly != null)' \
           <<<"$CACHED_BODY" >/dev/null 2>&1; then
      CACHED_OK=1
    fi
    ;;
  2|9) CACHE_W=0 ;;
esac

# Fresh cache short-circuits the request. The age comes from the fstat(2) of
# the already-open descriptor reported above — no second pathname lookup.
if [ "$FORCE" -eq 0 ] && [ "$CACHED_OK" = 1 ]; then
  age=$(( $(date +%s) - CACHED_MTIME ))
  if [ "$age" -ge 0 ] && [ "$age" -lt "$TTL" ]; then
    printf '%s\n' "$CACHED_BODY"
    exit 0
  fi
fi

# --- Key read: one fused secure operation ---------------------------------
# Exit 0 with the key on stdout, 1 = missing/empty (nokey), 2 = unsafe
# (badkey). The key travels from the descriptor to this shell variable and
# then straight into curl's private config pipe — never through argv or env.
key=""
key="$(python3 "$SECIO" read-key "$KEY_FILE" 2>/dev/null)"
case $? in
  0) ;;
  1) emit_fail "nokey"; exit 0 ;;
  *) emit_fail "badkey"; exit 0 ;;
esac

body_file="$(mktemp)"
trap 'rm -f "$body_file"' EXIT

# The key travels through a private pipe into curl's config reader (-K), so
# it never shows up in any argv. The body (plus a trailing "\n<http_code>"
# write-out) flows through `head -c MAX+1`: a response larger than MAX_BYTES
# is cut off producer-side and rejected below before parsing.
curl -s --max-time 10 -w '\n%{http_code}' "$API" \
  -K <(printf 'header = "Authorization: Bearer %s"\n' "$key") \
  | head -c $((MAX_BYTES + 1)) > "$body_file" || true

# Overflow rejection BEFORE any parsing.
if [ "$(wc -c < "$body_file")" -gt "$MAX_BYTES" ]; then
  emit_fail "badresp"
  exit 0
fi

http="$(tail -n 1 "$body_file" 2>/dev/null)"
case "$http" in
  [0-9][0-9][0-9]) ;;
  *) http="000" ;;
esac
resp="$(sed '$d' "$body_file" 2>/dev/null)"

if [ "$http" = "000" ]; then
  emit_fail "network"; exit 0
fi
if [ "$http" = "401" ] || [ "$http" = "403" ]; then
  emit_fail "unauthorized"; exit 0
fi

# The API can also answer HTTP 200 with an embedded auth failure
# ({"code":401,"msg":"令牌已过期或验证不正确","success":false}).
api_code=$(jq -r 'try (.code // 0) catch 0' <<<"$resp" 2>/dev/null) || api_code=0
if [ "$api_code" = "401" ] || [ "$api_code" = "403" ]; then
  emit_fail "unauthorized"; exit 0
fi

report=$(jq -nc --argjson now "$(now_ms)" --argjson fh "$FIVE_HOUR_MS" \
    --argjson wk "$WEEK_MS" --arg resp "$resp" '
  ($resp | try fromjson catch null) as $r
  | ($r.data // null) as $d
  | def win(unit; ms):
      ([$d.limits[]? | select(.unit == unit)][0]
       | if . then
           { used: (.currentValue // 0), quota: (.usage // 0),
             remaining: (.remaining // 0), windowMs: ms,
             nextResetMs: (.nextResetTime // 0) }
         else null end);
  { level: ($d.level // ""), fetchedAt: $now, stale: false, error: "",
    fiveHour: win(3; $fh), weekly: win(6; $wk) }
' 2>/dev/null) || report=""

if jq -e '(.fiveHour != null) and (.weekly != null)
          and (.fiveHour.quota > 0) and (.weekly.quota > 0)
          and (.fiveHour.nextResetMs > 0) and (.weekly.nextResetMs > 0)' \
    <<<"$report" >/dev/null 2>&1; then
  # Publish through secio: exclusive unpredictable temporary created and
  # renamed relative to the pinned cache-directory descriptor; rename(2)
  # replaces a symlink planted at the destination instead of following it.
  if [ "$CACHE_W" = 1 ]; then
    printf '%s\n' "$report" \
      | python3 "$SECIO" write-cache "$CACHE_DIR" "$CACHE_NAME" 2>/dev/null \
      || true
  fi
  printf '%s\n' "$report"
else
  emit_fail "badresp"
fi
exit 0
